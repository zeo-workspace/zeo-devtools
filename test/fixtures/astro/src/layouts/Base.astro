---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style is:global>
      body { margin: 0; font-family: sans-serif; }
      .card { display: inline-block; width: 200px; min-height: 96px; margin: 8px; padding: 8px; border: 1px solid #999; }
      .card h2 { margin: 0; font-size: 14px; }
    </style>
  </head>
  <body>
    <header id="layout-header">Layout header</header>
    <main id="layout-main">
      <slot />
    </main>
  </body>
</html>
