{
  "name": "@lucascouts/zeo-devtools",
  "version": "0.2.0",
  "description": "Vite and Astro dev plugin: click an element in the page and Zeo's agent composer receives its JSX or .astro source, a DOM summary and a screenshot.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zeo-workspace/zeo-devtools#readme",
  "bugs": {
    "url": "https://github.com/zeo-workspace/zeo-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeo-workspace/zeo-devtools.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e",
    "format:check": "prettier --check src test e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@astrojs/compiler-rs": ">=0.4.1",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler-rs": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "magic-string": "^1.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "7.3.8",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
